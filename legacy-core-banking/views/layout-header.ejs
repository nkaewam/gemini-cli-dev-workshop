<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>KTB Legacy Core Banking System</title>
    <style>
        body {
            font-family: 'Arial', sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f4f7f6;
            color: #333;
        }
        .header {
            background-color: #003366;
            color: #fff;
            padding: 15px 20px;
            border-bottom: 4px solid #ffcc00;
        }
        .header h1 {
            margin: 0;
            font-size: 24px;
            display: inline-block;
        }
        .nav {
            float: right;
            margin-top: 5px;
        }
        .nav a {
            color: #fff;
            text-decoration: none;
            margin-left: 15px;
            font-weight: bold;
            font-size: 14px;
        }
        .nav a:hover {
            text-decoration: underline;
            color: #ffcc00;
        }
        .container {
            width: 80%;
            margin: 30px auto;
            background: #fff;
            padding: 25px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
            border-radius: 4px;
            border: 1px solid #ccc;
        }
        .alert {
            padding: 10px;
            background-color: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
            margin-bottom: 15px;
            border-radius: 3px;
        }
        .success {
            padding: 10px;
            background-color: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
            margin-bottom: 15px;
            border-radius: 3px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
        }
        table, th, td {
            border: 1px solid #ddd;
        }
        th, td {
            padding: 12px;
            text-align: left;
        }
        th {
            background-color: #eaeaea;
        }
        tr:nth-child(even) {
            background-color: #f9f9f9;
        }
        .btn {
            display: inline-block;
            padding: 8px 15px;
            background-color: #003366;
            color: white;
            text-decoration: none;
            border-radius: 3px;
            border: none;
            cursor: pointer;
            font-size: 14px;
        }
        .btn:hover {
            background-color: #002244;
        }
        .btn-warning {
            background-color: #cc0000;
        }
        .btn-warning:hover {
            background-color: #990000;
        }
        .form-group {
            margin-bottom: 15px;
        }
        .form-group label {
            display: block;
            font-weight: bold;
            margin-bottom: 5px;
        }
        .form-group input, .form-group select, .form-group textarea {
            width: 100%;
            padding: 8px;
            box-sizing: border-box;
            border: 1px solid #ccc;
            border-radius: 3px;
        }
        .badge {
            background: #ffcc00;
            color: #003366;
            padding: 2px 6px;
            border-radius: 3px;
            font-size: 11px;
            font-weight: bold;
        }
        .footer {
            text-align: center;
            padding: 20px;
            font-size: 12px;
            color: #777;
            border-top: 1px solid #ddd;
            margin-top: 40px;
        }
    </style>
</head>
<body>

<div class="header">
    <h1>🏛️ KTB Core Banking (Legacy v1.0)</h1>
    <div class="nav">
        <% if (typeof role !== 'undefined') { %>
            <span style="color: #ddd; margin-right: 10px;">User: <strong><%= typeof fullName !== 'undefined' ? fullName : 'Customer' %></strong></span>
            <% if (role === 'admin') { %>
                <span class="badge">ADMIN</span>
                <a href="/admin">Console</a>
            <% } %>
            <a href="/">Dashboard</a>
            <a href="/accounts">Accounts</a>
            <a href="/transfers">Transfer</a>
            <a href="/logout">Logout</a>
        <% } else { %>
            <a href="/login">Login</a>
            <a href="/register">Register</a>
        <% } %>
    </div>
</div>

<div class="container">
