<%- include('layout-header') %>

<h2>Wire Funds Transfer</h2>
<p>Perform real-time operating fund movements across core mainframe accounts.</p>

<% if (error) { %>
    <div class="alert"><%- error %></div>
<% } %>
<% if (success) { %>
    <div class="success"><%- success %></div>
<% } %>

<div style="max-width: 500px;">
    <form action="/transfers" method="POST">
        <!-- IDOR Vulnerability: Source account is posted directly by client. Server does not check if source account belongs to logged-in user -->
        <div class="form-group" style="background: #e8f4f8; padding: 10px; border-left: 4px solid #17a2b8; border-radius: 3px;">
            <label style="color: #0c5460;">Source Account Number <small>[IDOR Flaw]</small></label>
            <input type="text" name="fromAccount" value="<%= fromAccount || (accounts && accounts.length > 0 ? accounts[0].account_number : '') %>" required placeholder="ACC-XXXXXX">
            <small style="color: #0c5460; display: block; margin-top: 4px;">
                <em>Vulnerability:</em> Change this to any valid account (e.g. <code>ACC-000001</code>) to siphon funds from another user's account without authorization!
            </small>
        </div>

        <div class="form-group">
            <label>Destination Account Number</label>
            <input type="text" name="toAccount" required placeholder="ACC-XXXXXX">
            <small style="color: #666;">Enter the recipient's account identifier.</small>
        </div>

        <!-- Business Logic Flaw: Negative/Zero check omitted -->
        <div class="form-group" style="background: #fff3cd; padding: 10px; border-left: 4px solid #ffc107; border-radius: 3px;">
            <label style="color: #856404;">Transfer Amount (THB) <small>[Logic Flaw]</small></label>
            <input type="number" step="0.01" name="amount" required placeholder="100.00">
            <small style="color: #856404; display: block; margin-top: 4px;">
                <em>Vulnerability:</em> The mainframe validation logic fails to block negative integers. Try transferring <code>-5000</code> to increase source balance and deduct from destination!
            </small>
        </div>

        <!-- Stored XSS Flaw: Description saved unescaped -->
        <div class="form-group" style="background: #f8d7da; padding: 10px; border-left: 4px solid #dc3545; border-radius: 3px;">
            <label style="color: #721c24;">Transfer Memo / Description <small>[Stored XSS Flaw]</small></label>
            <textarea name="description" rows="3" placeholder="Standard wire transfer memo"></textarea>
            <small style="color: #721c24; display: block; margin-top: 4px;">
                <em>Vulnerability:</em> Input containing script payloads like <code>&lt;script&gt;alert(document.cookie)&lt;/script&gt;</code> will execute automatically when the destination party reviews their ledger history.
            </small>
        </div>

        <button type="submit" class="btn" style="background-color: #28a745; font-size: 16px;">Execute Wire</button>
    </form>
</div>

<div style="margin-top: 20px;">
    <p><small>🔒 Secured with Legacy Null-Token Verification (No CSRF Protection Enabled).</small></p>
</div>

<%- include('layout-footer') %>
