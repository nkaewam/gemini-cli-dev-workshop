<%- include('layout-header') %>

<h2>Wire Funds Transfer</h2>
<p>Perform real-time operating fund movements across core mainframe accounts.</p>

<% if (error) { %>
    <div class="alert"><%- error %></div>
<% } %>
<% if (success) { %>
    <div class="success"><%- success %></div>
<% } %>

<div style="max-width: 500px;">
    <form action="/transfers" method="POST">
        <div class="form-group">
            <label>Source Account Number</label>
            <input type="text" name="fromAccount" value="<%= fromAccount || (accounts && accounts.length > 0 ? accounts[0].account_number : '') %>" required placeholder="ACC-XXXXXX">
        </div>

        <div class="form-group">
            <label>Destination Account Number</label>
            <input type="text" name="toAccount" required placeholder="ACC-XXXXXX">
            <small style="color: #666;">Enter the recipient's account identifier.</small>
        </div>

        <div class="form-group">
            <label>Transfer Amount (THB)</label>
            <input type="number" step="0.01" name="amount" required placeholder="100.00">
        </div>

        <div class="form-group">
            <label>Transfer Memo / Description</label>
            <textarea name="description" rows="3" placeholder="Standard wire transfer memo"></textarea>
        </div>

        <button type="submit" class="btn" style="background-color: #28a745; font-size: 16px;">Execute Wire</button>
    </form>
</div>

<div style="margin-top: 20px;">
    <p><small>🔒 Secured with Legacy Null-Token Verification (No CSRF Protection Enabled).</small></p>
</div>

<%- include('layout-footer') %>
