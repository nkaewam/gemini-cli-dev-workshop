<%- include('layout-header') %>

<h2>System Login</h2>
<p>Please enter your authentication credentials below to access core banking functions.</p>

<% if (error) { %>
    <div class="alert"><strong>Error:</strong> <%- error %></div>
<% } %>

<div style="max-width: 400px;">
    <form action="/login" method="POST">
        <div class="form-group">
            <label>Username</label>
            <input type="text" name="username" required placeholder="e.g. johndoe or admin">
        </div>
        <div class="form-group">
            <label>Password</label>
            <input type="password" name="password" required placeholder="Password">
        </div>
        <button type="submit" class="btn">Login</button>
    </form>
</div>

<div style="margin-top: 20px; padding-top: 15px; border-top: 1px solid #eee;">
    <p><small><strong>Demo Accounts:</strong> <code>admin</code> / <code>admin123!</code> or <code>johndoe</code> / <code>password123</code></small></p>
</div>

<%- include('layout-footer') %>
